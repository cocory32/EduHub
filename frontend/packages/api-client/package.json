{
  "name": "@eduhub/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "백엔드 OpenAPI 스펙(/v3/api-docs)에서 생성한 Axios 클라이언트. src/generated는 직접 고치지 않는다",
  "main": "src/generated/index.ts",
  "types": "src/generated/index.ts",
  "scripts": {
    "generate:api": "openapi-generator-cli generate -i http://localhost:8080/v3/api-docs -g typescript-axios -o src/generated --additional-properties=supportsES6=true"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.15.3"
  }
}
