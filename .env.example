# 로컬 개발용 환경 변수 예시. 실제 값은 .env에 쓰고 커밋하지않는다

# 백엔드 DB 접속 정보 (로컬 PostgreSQL)
# URL은 반드시 jdbc:postgresql:// 로 시작한다. 사용자와 비밀번호는 URL에 넣지 말고 아래 변수에 따로 쓴다.
# 예: DB_URL=jdbc:postgresql://localhost:5432/eduhub

# dev 프로필 (bootRun)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# test 프로필 (./gradlew test). dev와 다른 DB를 쓴다
# 예: TEST_DB_URL=jdbc:postgresql://localhost:5432/eduhub_test
TEST_DB_URL=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
